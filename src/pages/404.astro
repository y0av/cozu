---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found | Cozu" description="This page does not exist. Browse the free 3D models on Cozu." noindex>
  <section class="section section--page" aria-labelledby="nf-h">
    <div class="wrap page-head">
      <h1 id="nf-h">This page does not exist</h1>
      <p class="t-lead">The model may have moved. Every model is listed on the assets page.</p>
      <p><a class="btn btn--primary" href="/assets">Browse assets</a></p>
    </div>
  </section>
</Base>
