---
import Base from '../../layouts/Base.astro';
import AssetCard from '../../components/AssetCard.astro';
import { SITE, assetPath } from '../../lib/site.mjs';
import { assets, categories } from '../../lib/assets.mjs';

const jsonld = [{
  '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Free 3D assets', url: `${SITE}/assets`,
  mainEntity: { '@type': 'ItemList', itemListElement: assets.map((a, i) => ({ '@type': 'ListItem', position: i + 1, url: SITE + assetPath(a.slug), name: a.title })) },
}];
const words = (a) => [a.title, a.summary, a.category, ...a.tags, ...a.formats].join(' ').toLowerCase();
---
<Base title="Free 3D models and assets | Cozu" description={`Every free model on Cozu: ${assets.length} ${assets.length === 1 ? 'asset' : 'assets'} in GLB and OBJ with LODs and rigs, free for commercial use with a credit link.`} jsonld={jsonld} current="assets">
  <section class="section section--page" aria-labelledby="list-h">
    <div class="wrap stack-6">
      <div class="page-head">
        <h1 id="list-h">Free 3D models</h1>
        <p class="t-lead">Every model is free for commercial work. Credit Cozu with the line on its page. New models land here first.</p>
      </div>
      <div class="list-tools">
        <label class="search"><span class="t-label">Search</span><input type="search" id="q" placeholder="truck, rigged, GLB" autocomplete="off"></label>
        <nav class="cats" aria-label="Categories"><a href="/assets" aria-current="page">All <span class="muted">{assets.length}</span></a>{categories.map((c) => <a href={`/categories/${c.id}`}>{c.name} <span class="muted">{c.count}</span></a>)}</nav>
      </div>
      <div class="grid assets-grid" id="list">
        {assets.map((a, i) => <div class="span-4 list-item" data-words={words(a)}><AssetCard asset={a} eager={i < 3} span="" /></div>)}
      </div>
      <p class="muted" id="none" hidden>No model matches that yet. More arrive every week; <a class="link" href="https://github.com/y0av/cozu/issues">ask for one on GitHub</a>.</p>
    </div>
  </section>
</Base>
<script>
  const q = document.getElementById('q') as HTMLInputElement;
  const items = [...document.querySelectorAll<HTMLElement>('.list-item')];
  const none = document.getElementById('none')!;
  const run = () => {
    const terms = q.value.toLowerCase().split(/\s+/).filter(Boolean);
    let shown = 0;
    for (const it of items) { const ok = terms.every((t) => it.dataset.words!.includes(t)); it.hidden = !ok; if (ok) shown++; }
    none.hidden = shown > 0;
  };
  const start = new URLSearchParams(location.search).get('q');
  if (start) q.value = start;
  q.addEventListener('input', run);
  run();
</script>
