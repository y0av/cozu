---
// Home: the catalog itself. Every asset as a tile, a search box and the categories.
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import AssetCard from '../components/AssetCard.astro';
import { SITE, NAME, fileUrl, assetPath } from '../lib/site.mjs';
import { assets, categories } from '../lib/assets.mjs';

const latest = assets[0];
const hero = latest.previews[0];
const og = await getImage({ src: fileUrl(latest, hero.file), width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 82 });
const description = 'Free, game-ready 3D models in GLB and OBJ with LODs, rigs and collision. Free for commercial use with a credit link. No account.';
const jsonld = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: NAME, url: SITE, description, inLanguage: 'en' },
  { '@context': 'https://schema.org', '@type': 'Organization', name: NAME, url: SITE, logo: `${SITE}/favicon.svg` },
  { '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Free 3D models', url: SITE,
    mainEntity: { '@type': 'ItemList', itemListElement: assets.map((a, i) => ({ '@type': 'ListItem', position: i + 1, url: SITE + assetPath(a.slug), name: a.title })) } },
];
const words = (a) => [a.title, a.summary, a.category, ...a.tags, ...a.formats].join(' ').toLowerCase();
---
<Base title="Cozu: free 3D models for games and apps" description={description} image={new URL(og.src, SITE).href} imageAlt={hero.alt} jsonld={jsonld}>
  <section class="section section--page" aria-labelledby="list-h">
    <div class="wrap stack-6">
      <div class="list-head">
        <h1 id="list-h">Free 3D models</h1>
        <div class="list-tools">
          <label class="search"><span class="sr-only">Search models</span><input type="search" id="q" placeholder="Search models" autocomplete="off"></label>
          {categories.length > 1 && <nav class="cats" aria-label="Categories"><a href="/" aria-current="page">All</a>{categories.map((c) => <a href={`/categories/${c.id}`}>{c.name}</a>)}</nav>}
        </div>
      </div>
      <div class="grid assets-grid" id="list">
        {assets.map((a, i) => <div class="span-4 list-item" data-words={words(a)}><AssetCard asset={a} eager={i < 3} span="" /></div>)}
      </div>
      <p class="muted" id="none" hidden>No model matches that yet.</p>
    </div>
  </section>
</Base>
<script>
  const q = document.getElementById('q') as HTMLInputElement;
  const items = [...document.querySelectorAll<HTMLElement>('.list-item')];
  const none = document.getElementById('none')!;
  const run = () => {
    const terms = q.value.toLowerCase().split(/\s+/).filter(Boolean);
    let shown = 0;
    for (const it of items) { const ok = terms.every((t) => it.dataset.words!.includes(t)); it.hidden = !ok; if (ok) shown++; }
    none.hidden = shown > 0;
  };
  const start = new URLSearchParams(location.search).get('q');
  if (start) q.value = start;
  q.addEventListener('input', run);
  run();
</script>
