---
// Every page: the design-taste-frontend kit (public/kit, plain files) with the dealt palette and type.
// buttons solid, mark dots, palette blue-black-cornflower, type geist. Pared down to the catalog: the
// header holds the logo, the footer the directory.
import '../styles/site.css';
import geist from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import geistMono from '@fontsource/geist-mono/files/geist-mono-latin-400-normal.woff2?url';
import { SITE, NAME, REPO } from '../lib/site.mjs';
import { categories } from '../lib/assets.mjs';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  type?: string;
  jsonld?: object[];
  alternates?: { type: string; href: string; title: string }[];
  noindex?: boolean;
}
const { title, description, image, imageAlt, type = 'website', jsonld = [], alternates = [], noindex } = Astro.props;
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '');
const canonical = SITE + (path === '/' || path === '' ? '/' : path.replace(/\/$/, ''));
const fonts = `@font-face{font-family:'Geist';font-style:normal;font-weight:100 900;font-display:swap;src:url(${geist}) format('woff2')}@font-face{font-family:'Geist Mono';font-style:normal;font-weight:400;font-display:swap;src:url(${geistMono}) format('woff2')}`;
const palette = `:root{--p-bg:#0a0d14;--p-surface:#131824;--p-ink:#e9edf3;--p-muted:#8891a1;--p-accent:#5ab9fc;--p-accent-ink:#0a0d14;--p-action:#5ab9fc;--p-action-ink:#0a0d14;--p-inv-bg:#e9edf3;--p-inv-surface:#d7dbe1;--p-inv-ink:#0a0d14;--p-inv-muted:#54575f;--p-inv-accent:#0a0d14;--p-inv-accent-ink:#e9edf3;--p-inv-action:#0a0d14;--p-inv-action-ink:#e9edf3;--font-display:"Geist",system-ui,sans-serif;--font-text:"Geist",system-ui,sans-serif;--font-mono:"Geist Mono",ui-monospace,"SFMono-Regular",Menlo,Consolas,monospace;--display-weight:500;--display-tracking:-0.035em;--display-tracking-xl:-0.045em}`;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en" data-type="software" data-radius="soft" data-ground="sky" data-buttons="solid" data-motion>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
{noindex && <meta name="robots" content="noindex">}
<meta property="og:site_name" content={NAME}>
<meta property="og:type" content={type}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
{image && <meta property="og:image" content={image}>}
{image && <meta property="og:image:width" content="1200">}
{image && <meta property="og:image:height" content="630">}
{imageAlt && <meta property="og:image:alt" content={imageAlt}>}
<meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'}>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<meta name="theme-color" content="#0a0d14">
<meta name="site-kind" content="software">
<meta name="page-type" content="software">
<link rel="preload" href={geist} as="font" type="font/woff2" crossorigin>
<style is:inline set:html={fonts}></style>
<link rel="stylesheet" href="/kit/system.css">
<link rel="stylesheet" href="/kit/motion/motion.css">
<style is:inline set:html={palette}></style>
<script is:inline>document.documentElement.classList.add('m-enter');setTimeout(()=>document.documentElement.classList.add('m-enter-done'),700)</script>
<link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt">
<link rel="alternate" type="application/json" href="/api/v1/assets.json" title="Cozu asset catalog (JSON)">
{alternates.map((a) => <link rel="alternate" type={a.type} href={a.href} title={a.title}>)}
{jsonld.map((j) => <script type="application/ld+json" is:inline set:html={JSON.stringify(j)} />)}
<slot name="head" />
</head>
<body>
<header class="nav">
  <div class="wrap nav__bar">
    <a class="skip-link" href="#top">Skip to content</a>
    <a class="nav__logo" href="/"><span class="mark" data-mark="dots" aria-hidden="true"></span>Cozu</a>
  </div>
</header>

<main id="top">
  <slot />
</main>

<footer class="footer site-footer">
  <div class="wrap">
    <div class="grid">
      <div class="span-4"><a class="nav__logo" href="/"><span class="mark" data-mark="dots" aria-hidden="true"></span>Cozu</a></div>
      <div class="span-2 footer__col"><h3>Assets</h3><ul><li><a href="/">All assets</a></li>{categories.map((c) => <li><a href={`/categories/${c.id}`}>{c.name}</a></li>)}</ul></div>
      <div class="span-2 footer__col"><h3>License</h3><ul><li><a href="/license">How to credit</a></li><li><a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a></li></ul></div>
      <div class="span-2 footer__col"><h3>Developers</h3><ul><li><a href="/developers">API</a></li><li><a href="/developers#mcp">MCP server</a></li><li><a href="/llms.txt">llms.txt</a></li></ul></div>
      <div class="span-2 footer__col"><h3>Project</h3><ul><li><a href={REPO}>Source code</a></li><li><a href="/sitemap-index.xml">Sitemap</a></li></ul></div>
    </div>
    <div class="footer__legal"><span>&copy; {year} Cozu</span></div>
  </div>
</footer>
<script type="module" is:inline src="/kit/system.js"></script>
<script type="module" is:inline src="/kit/motion/motion.js"></script>
</body>
</html>
